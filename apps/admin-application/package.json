{
  "name": "admin-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "pages:build": "pnpm exec @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "eslint",
    "preview": "pnpm exec wrangler pages dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "stage:deploy": "pnpm run build && pnpm run pages:build && wrangler pages deploy .vercel/output/static --project-name=admin-application --env=stage",
    "production:deploy": "pnpm run build && pnpm run pages:build && wrangler pages deploy .vercel/output/static --project-name=admin-application --env=production"
  },
